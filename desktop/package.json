{
  "name": "local-intel-desktop",
  "productName": "Local Intel",
  "version": "1.1.0",
  "description": "Local Intel for EVE Online as a Windows app: tray, always on top, notifications in the background.",
  "main": "main.js",
  "author": "quietstatic01",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.quietstatic.localintel",
    "productName": "Local Intel",
    "artifactName": "LocalIntel-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "offline.html",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "LocalIntel-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "LocalIntel-Setup-${version}.${ext}",
      "shortcutName": "Local Intel"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "quietstatic01",
        "repo": "Eve-Intel",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quietstatic01/Eve-Intel.git"
  }
}
