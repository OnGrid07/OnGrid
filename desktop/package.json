{
  "name": "local-intel-desktop",
  "productName": "OnGrid",
  "version": "1.5.1",
  "description": "OnGrid for EVE Online as a Windows app: tray, always on top, notifications in the background.",
  "main": "main.js",
  "author": "OnGrid07",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.ongrid.app",
    "productName": "OnGrid",
    "artifactName": "OnGrid-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "offline.html",
      "launcher.html",
      "launcher-preload.js",
      "overlay.html",
      "overlay-preload.js",
      "page-preload.js",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "OnGrid-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "OnGrid-Setup-${version}.${ext}",
      "shortcutName": "OnGrid"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OnGrid07",
        "repo": "OnGrid",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OnGrid07/OnGrid.git"
  }
}
